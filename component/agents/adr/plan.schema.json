{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["title", "approach", "architecture", "technologies", "components"],
  "properties": {
    "title": { "type": "string" },
    "approach": { "type": "string" },
    "architecture": { "type": "string" },
    "technologies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "role"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string" }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "purpose"],
        "properties": {
          "name": { "type": "string" },
          "purpose": { "type": "string" },
          "details": { "type": "string" }
        }
      }
    },
    "dataFlow": { "type": "string" },
    "deployment": { "type": "string" }
  }
}
