+            def start_swtpm():
+                tpm_dir = os.path.join(os.environ["NIX_BUILD_TOP"], "swtpm")
+                socket_path = os.path.join(tpm_dir, "socket")
+                os.makedirs(tpm_dir, exist_ok=True)
+                if os.path.lexists(socket_path):
+                    os.unlink(socket_path)
+                process = subprocess.Popen([
+                    "${pkgs.swtpm}/bin/swtpm", "socket",
+                    "--tpmstate", f"dir={tpm_dir}",
+                    "--ctrl", f"type=unixio,path={socket_path}",
+                    "--tpm2",
+                    "--log", f"file={tpm_dir}/stdout,level=6",
+                ])
+                deadline = time.monotonic() + 5
+                while not os.path.exists(socket_path):
+                    exit_code = process.poll()
+                    if exit_code is not None:
+                        raise RuntimeError(f"swtpm exited with code {exit_code}")
+                    if time.monotonic() >= deadline:
+                        stop_swtpm(process)
+                        raise TimeoutError("timed out waiting for swtpm socket")
+                    time.sleep(0.05)
+                if process.poll() is not None:
+                    raise RuntimeError(f"swtpm exited with code {process.returncode}")
+                atexit.register(stop_swtpm, process)
+                return process
+
+            def stop_swtpm(process):
+                if process.poll() is not None:
+                    return
+                process.terminate()
+                try:
+                    process.wait(timeout=5)
+                except subprocess.TimeoutExpired:
+                    process.kill()
+                    process.wait(timeout=5)
+
+            def restart_swtpm(process, reset_state=False):
+                stop_swtpm(process)
+                if reset_state:
+                    shutil.rmtree(os.path.join(os.environ["NIX_BUILD_TOP"], "swtpm"))
+                return start_swtpm()
+
