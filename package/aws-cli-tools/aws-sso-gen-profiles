# Generate AWS configuration profiles for all accounts and roles accessible via
# the given SSO start URL.

direct=0
prefix=
config="${AWS_CONFIG_FILE:-$HOME/.aws/config}"
profile="$AWS_PROFILE"
jobs="${AWS_SSO_GEN_PROFILES_JOBS:-8}"

set -eu -o pipefail
IFS=$'\n\t'

parse_args() {
  while true; do
    case "${1:-}" in
      -d|--direct ) direct=1     ; shift   ;;
      -n|--prefix ) prefix="$2"  ; shift 2 ;;
      -p|--profile) profile="$2" ; shift 2 ;;
      -j|--jobs   ) jobs="$2"    ; shift 2 ;;
      *           ) break                  ;;
    esac
  done
}

# Index the roles available in a single account, writing the resulting profile
# stanzas (NUL-terminated, so they survive later sorting) to $outfile. Intended
# to be launched in the background; relies on variables set up by main().
process_account() {
  local dest_account_index="$1" dest_account_id="$2" dest_account_name="$3" outfile="$4"
  echo "$0: processing ${dest_account_name} (${dest_account_id}; $(( dest_account_index + 1 )) of ${num_accounts})" >&2
  # The AWS CLI silently ignores profile names containing whitespace, so slugify
  # the account name before building the profile stanza.
  local dest_account_slug="${dest_account_name//[[:space:]]/-}"
  local template
  if (( $direct == 0 )); then
    template='.roleList[] | "[profile '"${prefix}${dest_account_slug}"'--\(.roleName)]\nsso_session = '"$sso_session"'\nsso_account_id = '"$dest_account_id"'\nsso_role_name = \(.roleName)\u0000"'
  else
    template='.roleList[] | "[profile '"${prefix}${dest_account_slug}"'--\(.roleName)]\nsso_start_url = '"$start_url"'\nsso_region = '"$sso_region"'\nsso_account_id = '"$dest_account_id"'\nsso_role_name = \(.roleName)\u0000"'
  fi
  aws sso list-account-roles \
      --region "$sso_region" \
      --access-token "${access_token}" \
      --account-id "${dest_account_id}" \
      --output json | jq -j "$template" > "$outfile"
}

main() {
  echo "$0: fetching ${profile}'s SSO configuration" >&2
  local account_id="$(aws configure get sso_account_id --profile "${profile}")"
  local role_name="$(aws configure get sso_role_name --profile "${profile}")"
  local region="$(aws configure get region --profile "${profile}")"
  local start_url="$(aws configure get sso_start_url --profile "${profile}")"

  local cache_key sso_session="$(aws configure get sso_session --profile "${profile}")"
  local registration_scopes=
  if [[ -n "$sso_session" ]]; then
    if [[ -z "$start_url" ]]; then
      start_url="$(sed -nr "/^\[sso-session[ ]*${sso_session}\]/ { :l /^sso_start_url[ ]*=/ { s/[^=]*=[ ]*//; p; q; }; n; b l; }" "$config")"
    fi
    if [[ -z "$start_url" ]]; then
      echo "$0: failed to determine sso_start_url for profile ${profile}" >&2
      exit 1
    fi
    cache_key="$(printf "%s" "$sso_session" | shasum -a 1 | awk '{print $1}')"
    if (( $direct == 0 )); then
      registration_scopes="$(aws configure get sso_registration_scopes --sso-session "$sso_session" || true)"
    fi
  elif [[ -n "$start_url" ]]; then
    cache_key="$(printf "%s" "$start_url" | shasum -a 1 | awk '{print $1}')"
    sso_session="${start_url#*://}"
    sso_session="${sso_session%%[/:?#]*}"
    registration_scopes="sso:account:access"
  else
    echo "$0: failed to determine sso_start_url and sso_session for profile ${profile}" >&2
    exit 1
  fi
  echo "$0: using cached credential ${cache_key}" >&2

  local cache_file="${HOME}/.aws/sso/cache/$cache_key.json"
  if [[ ! -f "$cache_file" ]] ; then
    echo "$0: no SSO session found; retry after running: aws sso login --profile \"${profile}\"" >&2
    exit 1
  fi
  local access_token="$(jq -r .accessToken "$cache_file")"
  local sso_region="$(jq -r .region "$cache_file")"

  accounts="$(aws sso list-accounts \
      --region "$sso_region" \
      --access-token "$access_token" \
      --output json)"
  local num_accounts="$(printf "%s" "$accounts" | jq -r '.accountList | length')"
  echo "$0: found ${num_accounts} accounts" >&2
  # Index each account's roles concurrently, capping at $jobs in flight so we
  # don't overwhelm the SSO API. Each worker writes its stanzas to its own file
  # so output can't interleave.
  local workdir="$(mktemp -d)"
  while IFS=$'\t' read -r dest_account_index dest_account_id dest_account_name; do
    while (( $(jobs -rp | wc -l) >= jobs )); do
      wait -n
    done
    process_account "$dest_account_index" "$dest_account_id" "$dest_account_name" \
      "$workdir/$dest_account_index" &
  done < <(printf "%s" "$accounts" | jq -r '.accountList | sort_by([(.accountName | gsub("[[:space:]]"; "-")), .accountId]) | to_entries[] | [.key, .value.accountId, .value.accountName] | @tsv')
  wait

  # Sort profiles within each account, separating only non-empty accounts.
  local first_account=1
  if (( $direct == 0 )); then
    printf '[sso-session %s]\nsso_start_url = %s\nsso_region = %s\n' "$sso_session" "$start_url" "$sso_region"
    if [[ -n "$registration_scopes" ]]; then
      printf 'sso_registration_scopes = %s\n' "$registration_scopes"
    fi
    first_account=0
  fi
  for (( i = 0; i < num_accounts; i++ )); do
    if [[ -s "$workdir/$i" ]]; then
      if (( ! first_account )); then
        printf '\n'
      fi
      sort -z "$workdir/$i" | awk 'BEGIN { RS = "\0"; ORS = "\n" } length'
      first_account=0
    fi
  done
  
  rm -rf "$workdir"
}

parse_args "$@"
main
