+
+void MainWindow::fitTabToCurrentPage()
+{
+    QWidget *page = m_tabWidget->currentWidget();
+    if (!page) return;
+
+    // Cached size hints go stale when children are shown/hidden; rebuild them
+    // before measuring.
+    const auto children = page->findChildren<QWidget *>();
+    for (QWidget *child : children) {
+        if (child->layout()) child->layout()->invalidate();
+    }
+    if (page->layout()) {
+        page->layout()->invalidate();
+        page->layout()->activate();
+    }
+    page->updateGeometry();
+
+    const int pageHeight = qMax(page->sizeHint().height(), page->minimumSizeHint().height());
+    m_tabWidget->setMaximumHeight(pageHeight + m_tabWidget->tabBar()->sizeHint().height());
+
+    // Visibility changes are applied lazily; measure again once they settle.
+    if (!m_tabFitPending) {
+        m_tabFitPending = true;
+        QTimer::singleShot(0, this, [this]() {
+            fitTabToCurrentPage();
+        });
+    } else {
+        m_tabFitPending = false;
+    }
 }
 
