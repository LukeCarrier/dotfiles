From 09e942dcfeebfcc9872e0faab67097f102cc3209 Mon Sep 17 00:00:00 2001
From: Luke Carrier <luke@carrier.family>
Date: Sat, 16 May 2026 17:37:57 +0100
Subject: [PATCH 1/3] chore(deps): allow builds

---
 ui/package.json        | 6 ------
 ui/pnpm-workspace.yaml | 8 ++++++++
 2 files changed, 8 insertions(+), 6 deletions(-)

diff --git a/ui/package.json b/ui/package.json
index 361b903fb..46696b965 100644
--- a/ui/package.json
+++ b/ui/package.json
@@ -19,11 +19,5 @@
       "react": "^19.2.4",
       "react-dom": "^19.2.4"
     },
-    "onlyBuiltDependencies": [
-      "@modelcontextprotocol/ext-apps",
-      "electron",
-      "electron-winstaller",
-      "esbuild"
-    ]
   }
 }
diff --git a/ui/pnpm-workspace.yaml b/ui/pnpm-workspace.yaml
index c69463507..837b703e8 100644
--- a/ui/pnpm-workspace.yaml
+++ b/ui/pnpm-workspace.yaml
@@ -3,3 +3,11 @@ packages:
   - 'text'
   - 'desktop'
   - 'goose-binary/*'
+
+allowBuilds:
+  '@modelcontextprotocol/ext-apps': true
+  electron: true
+  electron-winstaller: true
+  esbuild: true
+
+blockExoticSubdeps: false
-- 
